{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/schemas/report-schema.v1.json",
  "title": "AgenticWebAppTestExecutorReportSchema",
  "description": "FIXED Phase-1 report schema for pass/fail documentation with evidence.",
  "type": "object",
  "required": ["run_id", "suite_id", "status", "started_at", "finished_at", "steps"],
  "additionalProperties": false,
  "properties": {
    "run_id": { "type": "string" },
    "suite_id": { "type": "string" },
    "suite_name": { "type": "string" },
    "module": { "type": "string" },
    "status": { "type": "string", "enum": ["passed", "failed", "error", "skipped"] },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "summary": {
      "type": "object",
      "required": ["total", "passed", "failed", "skipped"],
      "properties": {
        "total": { "type": "integer" },
        "passed": { "type": "integer" },
        "failed": { "type": "integer" },
        "skipped": { "type": "integer" }
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step_id", "action", "status"],
        "properties": {
          "step_id": { "type": "string" },
          "action": { "type": "string" },
          "description": { "type": "string" },
          "status": { "type": "string", "enum": ["passed", "failed", "skipped", "error"] },
          "expected": { "type": ["string", "null"] },
          "actual": { "type": ["string", "null"] },
          "started_at": { "type": ["string", "null"], "format": "date-time" },
          "finished_at": { "type": ["string", "null"], "format": "date-time" },
          "duration_ms": { "type": "integer" },
          "screenshot_path": { "type": ["string", "null"] },
          "error": { "type": ["string", "null"] }
        }
      }
    },
    "notify": {
      "type": "object",
      "properties": {
        "triggered": { "type": "boolean" },
        "team": { "type": ["string", "null"] },
        "channel": { "type": ["string", "null"] },
        "ticket_id": { "type": ["string", "null"] }
      }
    }
  }
}
