{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/schemas/step-schema.v1.json",
  "title": "AgenticWebAppTestExecutorStepSchema",
  "description": "FIXED Phase-1 step schema. Text steps are parsed into this JSON before Playwright execution.",
  "type": "object",
  "required": ["suite_id", "name", "steps"],
  "additionalProperties": false,
  "properties": {
    "suite_id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "module": {
      "type": "string",
      "description": "Used for team ownership routing, e.g. login, checkout, search"
    },
    "base_url": { "type": "string", "format": "uri" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "required": ["id", "action"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "action": {
          "type": "string",
          "enum": [
            "goto",
            "fill",
            "click",
            "select",
            "hover",
            "press_key",
            "wait",
            "assert_text",
            "assert_url",
            "assert_visible",
            "screenshot"
          ]
        },
        "url": { "type": "string" },
        "selector": { "type": "string" },
        "value": { "type": "string" },
        "key": { "type": "string" },
        "timeout_ms": { "type": "integer", "minimum": 0 },
        "expected": { "type": "string" },
        "description": { "type": "string" }
      }
    }
  }
}
