{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/schemas/structured_test_prompt.v1.json",
  "title": "StructuredTestPrompt",
  "description": "Fixed-format test input. Testers must fill every required field; free-form prompts are rejected.",
  "type": "object",
  "required": [
    "test_id",
    "site_url",
    "feature",
    "test_name",
    "objective",
    "expected_outcome",
    "steps"
  ],
  "additionalProperties": false,
  "properties": {
    "test_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique test case ID e.g. TC01_login_success"
    },
    "site_url": {
      "type": "string",
      "format": "uri",
      "description": "Application URL under test"
    },
    "feature": {
      "type": "string",
      "minLength": 1,
      "description": "Feature/module e.g. login, checkout, search"
    },
    "test_name": {
      "type": "string",
      "minLength": 1,
      "description": "Short human-readable test title"
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "description": "What this test validates"
    },
    "expected_outcome": {
      "type": "string",
      "minLength": 1,
      "description": "Overall expected result if all steps pass"
    },
    "environment": {
      "type": "string",
      "default": "demo",
      "description": "Target environment label e.g. demo, staging"
    },
    "owner_team": {
      "type": "string",
      "description": "Team to notify on failure (maps to config/team_ownership.yaml)"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Ordered action lines (no numbering required in JSON)"
    }
  }
}
