# Copy to .env and fill values
APP_NAME=Agentic Web-App Test Executor
APP_ENV=dev
DATABASE_URL=sqlite:///./data/executor.db

# LLM for step parsing (use one provider)
LLM_PROVIDER=groq
# OPENAI_API_KEY=
# GROQ_API_KEY=
# OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=openai/gpt-oss-20b

# Notifications
NOTIFY_ENABLED=true
NOTIFY_CHANNEL=console
# SLACK_WEBHOOK_URL=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=qa-bot@example.com

# Browser
HEADLESS=true
DEFAULT_TIMEOUT_MS=15000